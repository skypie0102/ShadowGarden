# Copy to .dev.vars for local development. Names match the owner's deployment;
# no secret values were recovered. Use development credentials here, never Git.
# Admin, session and media signing secrets must each be at least 32 characters.
SG_ADMIN_TOKEN=
# Independent new session secret; do not reuse the admin or media secret.
SESSION_SECRET=
SG_MEDIA_SIGNING_SECRET=
SG_TURNSTILE_SITE_KEY=
SG_TURNSTILE_SECRET_KEY=
# Exact allowed widget hostname (without scheme). Defaults to request hostname.
TURNSTILE_HOSTNAME=
B2_READ_KEY_ID=
B2_READ_APPLICATION_KEY=
B2_WRITE_KEY_ID=
B2_WRITE_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
# Alternative names remain supported: ADMIN_TOKEN, BOOK_SIGNING_SECRET,
# TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY. If present, each overrides its SG alias,
# even if empty. Configure only one naming scheme for each setting.
# A shared B2_APPLICATION_KEY_ID/B2_APPLICATION_KEY pair is also supported when
# neither role-specific variable is present for that role. Remove both empty
# role-specific lines above if using the shared pair; do not mix partial pairs.
# D1 binding DB must be migrated and explicitly seeded before administration works.
