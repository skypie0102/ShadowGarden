# Copy to .dev.vars for local development. These are NEW names, not recovered secrets.
# Use independent random secrets of at least 32 characters. No authentication bypass exists.
ADMIN_TOKEN=
SESSION_SECRET=
BOOK_SIGNING_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact allowed widget hostname (without scheme). Defaults to request hostname.
TURNSTILE_HOSTNAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
# D1 binding DB must be migrated and explicitly seeded before administration works.
