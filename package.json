{
  "name": "shadowgarden",
  "version": "2.19.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist",
    "audit": "node scripts/audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "check": "npm run audit && npm test && npm run build && npm run check:functions",
    "check:functions": "node scripts/build-pages-release.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "seed:local": "wrangler d1 execute DB --local --file recovery-info/seed.sql",
    "seed:empty": "wrangler d1 execute DB --local --file recovery-info/empty-seed.sql",
    "profile:reader": "npm run build && playwright test --config playwright.profile.config.mjs",
    "profile:library": "npm run build && playwright test --config playwright.library-profile.config.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "profile:uploads": "node scripts/profile-upload-memory.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.151.1"
  }
}
