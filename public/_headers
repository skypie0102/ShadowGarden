/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/admin*
  Cache-Control: no-store
/data/*
  Cache-Control: no-cache
/assets/js/*
  Cache-Control: no-cache
/assets/css/*
  Cache-Control: no-cache
